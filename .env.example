VERIFY_TOKEN=your_meta_verify_token
META_APP_SECRET=your_meta_app_secret
OPENAI_API_KEY=your_openai_api_key
WHATSAPP_TOKEN=your_meta_whatsapp_token
PHONE_NUMBER_ID=1253213371197813
# Local same-filesystem webhook deduplication ledger. Do not place farmer content here.
WHATSAPP_MESSAGE_STATE_FILE=.runtime/whatsapp-message-state.json
WHATSAPP_MESSAGE_DEDUP_TTL_MS=604800000
WHATSAPP_MESSAGE_DEDUP_MAX_COMPLETED=10000
# Fertilizer reminders stay read-only until explicitly enabled.
FERTILIZER_REMINDER_DRY_RUN=true
# Use only a Meta-approved Malayalam-first bilingual WhatsApp template.
FERTILIZER_REMINDER_TEMPLATE_NAME=
FERTILIZER_REMINDER_TEMPLATE_STATUS=
FERTILIZER_REMINDER_TEMPLATE_LANGUAGE=ml
# Optional approved WhatsApp destination for KVK training-request alerts.
KVK_TRAINING_ALERT_WHATSAPP=
# Government scheme sync is read-only/dry-run until the cache schema extension is approved.
SCHEME_SYNC_DRY_RUN=true
SCHEME_SYNC_TIMEOUT_MS=10000
SCHEME_SYNC_MAX_RETRIES=2
SCHEME_SYNC_RATE_LIMIT_MS=750
# Optional comma-separated allowlist, e.g. KERALA_SHM_MIDH,CENTRAL_FARM_MECHANIZATION
SCHEME_SYNC_SOURCE_IDS=
OPENAI_MODEL=gpt-5.5
PORT=10000
