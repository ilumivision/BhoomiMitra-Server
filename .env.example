VERIFY_TOKEN=your_meta_verify_token
META_APP_SECRET=your_meta_app_secret
OPENAI_API_KEY=your_openai_api_key
WHATSAPP_TOKEN=your_meta_whatsapp_token
PHONE_NUMBER_ID=1253213371197813
# Google Sheets service-account configuration. Use an approved test workbook
# for pilot validation; never place real credentials in this file.
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Required to sign private, expiring land-map access links.
LAND_MAP_ACCESS_SECRET=
# Required only for authorised Sentinel/Copernicus satellite requests.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# Non-production diagnostics also require an approved test land identity.
ENABLE_SATELLITE_DIAGNOSTICS=false
SATELLITE_DIAGNOSTIC_TOKEN=
SATELLITE_DIAGNOSTIC_LAND_ID=
SATELLITE_DIAGNOSTIC_FARMER_ID=
SATELLITE_DIAGNOSTIC_WHATSAPP=
# Local same-filesystem webhook deduplication ledger. Do not place farmer content here.
WHATSAPP_MESSAGE_STATE_FILE=.runtime/whatsapp-message-state.json
WHATSAPP_MESSAGE_DEDUP_TTL_MS=604800000
WHATSAPP_MESSAGE_DEDUP_MAX_COMPLETED=10000
# Fertilizer reminders stay read-only until explicitly enabled.
FERTILIZER_REMINDER_DRY_RUN=true
# Use only a Meta-approved Malayalam-first bilingual WhatsApp template.
FERTILIZER_REMINDER_TEMPLATE_NAME=
FERTILIZER_REMINDER_TEMPLATE_STATUS=
FERTILIZER_REMINDER_TEMPLATE_LANGUAGE=ml
# Optional approved WhatsApp destination for KVK training-request alerts.
KVK_TRAINING_ALERT_WHATSAPP=
# Optional approved HTTPS MP4/GIF reference for first-time onboarding only.
BHOOMIMITRA_WELCOME_MEDIA_URL=
BHOOMIMITRA_WELCOME_MEDIA_TYPE=video
# Publish only approved policy/contact details; blank values are disclosed as unconfigured.
BHOOMIMITRA_POLICY_URL=
BHOOMIMITRA_ORGANISATION_CONTACT=
# Government scheme sync is read-only/dry-run until the cache schema extension is approved.
SCHEME_SYNC_DRY_RUN=true
SCHEME_SYNC_TIMEOUT_MS=10000
SCHEME_SYNC_MAX_RETRIES=2
SCHEME_SYNC_RATE_LIMIT_MS=750
# Optional comma-separated allowlist, e.g. KERALA_SHM_MIDH,CENTRAL_FARM_MECHANIZATION
SCHEME_SYNC_SOURCE_IDS=
# Market updater is manual and disabled unless this gate is true and the
# market:update command is invoked with --execute. No scheduler is activated.
MARKET_UPDATE_ENABLED=false
OPENAI_MODEL=gpt-5.5
PORT=10000
